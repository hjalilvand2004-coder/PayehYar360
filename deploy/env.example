# نمونه تنظیمات بدون Secret — مقادیر واقعی را از مخزن امن تزریق کنید (بند ۱۴.۳)

ENV=prod

# --- دیتابیس (در compose خودکار ساخته می‌شود؛ اینجا فقط رمز) ---
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# --- RabbitMQ ---
RABBITMQ_PASSWORD=CHANGE_ME_strong_password

# --- SSO موجود سازمان (پرتال ورود یکپارچه دانشجویار۳۶۰) ---
OIDC_ISSUER=http://188.212.96.235:8086
# اگر توکن‌های SSO دارای aud هستند مقدار را تنظیم کنید؛ خالی = بدون بررسی aud
OIDC_AUDIENCE=
# client ثبت‌شده در پرتال: سامانه پایه پار۳۶۰ → appKey=hr، Client ID=payeh360
OIDC_CLIENT_ID=payeh360
# فقط اگر SSO روش محرمانه لازم داشته باشد
OIDC_CLIENT_SECRET=
# ریشه عمومی سامانه (برای ساخت login_url و redirect سراسری؛ خالی = استخراج از درخواست)
OIDC_PUBLIC_BASE_URL=http://188.212.96.235:8094
# قرارداد اکوسیستم: نقش دسترسی <appKey>.access در توکن‌های SSO
SSO_ACCESS_ROLE=hr.access
# مشتری پیش‌فرض کاربران SSO بدون claim مشتری (پایلوت)
SSO_DEFAULT_TENANT=demo

# --- CORS: مبادی مجاز ---
ALLOWED_ORIGINS=http://188.212.96.235:8094

# --- محدودسازی نرخ (درخواست در دقیقه برای هر هویت؛ 0=خاموش) ---
RATE_LIMIT_PER_MINUTE=600

# --- همگام‌سازی ---
CHANGE_RETENTION_MIN=50000
SNAPSHOT_TTL_HOURS=24
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=20
WORKERS_IN_PROCESS=false

# --- کلیدهای رمزنگاری (اجباری در تولید؛ از مخزن امن) ---
# ENCRYPTION_KEY: هر رشته بلند تصادفی (≥32 کاراکتر)
# SEARCH_HMAC_KEY: هر رشته بلند تصادفی (≥32 کاراکتر)
ENCRYPTION_KEY=CHANGE_ME_random_32_chars_minimum
SEARCH_HMAC_KEY=CHANGE_ME_random_32_chars_minimum

# --- دمو (فقط dev/test — در تولید هرگز true نکنید) ---
AUTO_CREATE_TABLES=false
SEED_DEMO=false
DEV_AUTH=false
